{
  "openapi": "3.1.0",
  "info": {
    "title": "ECG Axis Calculator — Demonstration Audit API",
    "version": "3.0.0-ENTERPRISE",
    "description": "Optional local FastAPI demonstration supervisor. This API does not calculate the ECG axis; use the Python CLI or the browser calculator for QRS-axis computation. The generated /openapi.json is authoritative."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "JSON health metadata"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Demonstration task and ledger counts",
        "responses": {
          "200": {
            "description": "JSON counts (not Prometheus text)"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate synthetic demonstration task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ],
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number",
                    "default": 0
                  },
                  "status_descriptor": {
                    "type": "string",
                    "default": "NOMINAL"
                  },
                  "is_critical_flag": {
                    "type": "boolean",
                    "default": false
                  },
                  "attributes": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Demonstration dossier"
          },
          "400": {
            "description": "Sensitive identifier rejected"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Mock adapter query (not a clinical model)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock response"
          },
          "400": {
            "description": "Query rejected"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Session-local HMAC audit records",
        "responses": {
          "200": {
            "description": "JSON chain and integrity check"
          }
        }
      }
    }
  }
}
